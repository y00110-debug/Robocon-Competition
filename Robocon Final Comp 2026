#SET UP 
import robot
import time
R = robot.Robot(max_motor_voltage = 9) #overvolting the motors to make them faster
R.zone = robot.TEAM.BLUE #change as we go

#DIRECTIONS - Motors go in opposite directions
def turnLeft(degrees):
  degrees = abs(degrees) #forces degrees to be positive
  print('Turning left',degrees,'degrees.')
  R.motors[0] = degrees
  R.motors[1] = degrees
  time.sleep(1)

def turnRight(degrees):
  degrees = (-1)*(abs(degrees)) #forces degrees to be negative
  print('Turning right',degrees,'degrees.')
  R.motors[0] = degrees
  R.motors[1] = degrees
  time.sleep(1)

def stop():
  print('Stopping.')
  R.motors[0] = 0
  R.motors[1] = 0
  time.sleep(1)

#MORE SET UP
R.enable_5v = True
R.servos[0] = -130
R.servos[1] = 90 #placing the wire upright

R.enable_5v = False #cutting the power to the servos to stop strain

savedMarkers = []
initial = 0
print('Ready')

#MARKER TRACKING - For both walls and crates
def followMarker(markertoFollow,grabBox):
  print('Moving towards the marker.')
  lastAngle = seekMarker(markertoFollow,0)
  initial = lastAngle #increased precision for grabbing crates later
  markers = R.see()
  markers = [m for m in markers if m.info.id == markertoFollow] #checks to make sure marker still exists
  for marker in markers:
    times = int(marker.dist*5.5)
    print('Need to travel',times,'times.')
    for i in range(times): #repeated searching and turning
      seekMarker(markertoFollow,lastAngle)
      time.sleep(0.2)
      R.motors[0] = 80
      R.motors[1] = -80
      time.sleep(0.2)
      print('Made it to the marker.')      
  if len(markers) == 0:
    print('Lost the marker, trying again.')
    savedMarkers.remove(markertoFollow)
    findCrate(savedMarkers)      
  if grabBox == True: #if we're grabbing a crate
    grabCrate(initial)
  else:
    return 0 

def seekMarker(markertoFollow,lastAngle):
  markers = R.see()
  if len(markers) == 0: #increasing precision when really close to the crate
    print('Lost the marker, going backwards.')
    R.motors[0] = -20
    R.motors[1] = 20
    time.sleep(0.5)
    correcting = (-1)*(lastAngle/3)
    if correcting>0:
      turnRight(correcting)
    else:
      turnLeft(correcting)
  for marker in markers:
    if marker.info.id == markertoFollow:
      angle = int((5)*(marker.bearing.y))
      print('Angle:',angle)
      if -10<=angle<=10:
        print('Facing towards the marker.')
        time.sleep(1)
      elif angle<0:
        print('Tracking to the right.')
        turnRight(angle/4)
      elif angle<0:
        print('Tracking to the left.')
        turnLeft(angle/4)
      lastAngle = angle
      return lastAngle


#CRATE HANDLING
def findCrate(savedMarkers):
  print('Searching for a crate.')
  markers = R.see()
  time.sleep(1)
  markers = [m for m in markers if (m.info.id not in savedMarkers) and (m.info.type == robot.MARKER_TYPE.CRATE)] #gets rid of markers we've already gotten and those that aren't crates
  for marker in markers:
    markertoFollow = marker.info.id
    print('Found a crate!')
  if len(markers) == 0:
    print('Nothing found')
    turnLeft(40)
    stop()
    findCrate(savedMarkers)
  savedMarkers.append(markertoFollow)
  followMarker(markertoFollow,True)

def grabCrate(initial):
  print('Grabbing the crate.')
  R.motors[0] = -40
  R.motors[1] = 40
  time.sleep(0.2) #recoil 
  if -10<=initial<=10:
    turnRight(55)
    time.sleep(0.2)
  elif initial>0:
    turnRight(65)
    time.sleep(0.2)
  elif initial<0:
    turnRight(50)
    time.sleep(0.2)
  stop() #increasing precision on full spin
  R.motors[0] = -120
  R.motors[1] = 120 #heavy recoil to ensure box goes under wire
  time.sleep(0.5)
  stop()
  R.enable_5v = True
  stop()
  R.servos[0] = 90
  R.servos[1] = -130 #placing wire down
  R.enable_5v = False #cutting the power to the servos to stop strain
  goCorner()

def dropCrate():
  print('Dropping off the crate.')
  R.motors[0] = -70
  R.motors[1] = 70
  time.sleep(0.2) #recoil and getting the servos ready
  turnRight(55)
  time.sleep(0.2)
  stop()
  R.enable_5v = True
  stop()
  R.servos[0] = -130
  R.servos[1] = 90 #placing the wire upright
  R.enable_5v = False #cutting the power to the servos to stop strain
  startRound()

#ARENA NAVIGATION
def startRound():
  stop()
  R.motors[0] = 250
  R.motors[1] = -250
  time.sleep(1)
  stop()
  R.motors[0] = 250
  R.motors[1] = -250
  time.sleep(1)
  stop()
  findCrate(savedMarkers)


def goCorner():
  print('Searching for the zone corner.')
  zoneMarkers = [[123,100],[105,106],[118,117],[111,112]] #red, yellow, blue, and green corner markers
  markers = R.see()
  if R.zone == robot.TEAM.RED: 
    lookingFor = 0
  elif R.zone == robot.TEAM.YELLOW: 
    lookingFor = 1
  if R.zone == robot.TEAM.BLUE: 
    lookingFor = 2
  if R.zone == robot.TEAM.GREEN: 
    lookingFor = 3
  markers = [m for m in markers if m.info.id in zoneMarkers[lookingFor]]
  for m in markers:
    cornerMarker = m.info.id
    print('Found our corner!')
  if len(markers) == 0: #in case robot is too close to the wall
    print('MMMMM yummy wall.')
    R.motors[0] = -25
    R.motors[1] = 25
    time.sleep(0.2)
    turnLeft(30)
    stop()
    R.motors[0] = 50
    R.motors[1] = -50
    time.sleep(1)
    stop()
    goCorner()
  followMarker(cornerMarker,False)
  dropCrate()

startRound()

    
