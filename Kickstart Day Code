#Hello(2)Code to make the LED Flash
import robot
import time
R=robot.Robot()


R.gpio[2].mode=robot.OUTPUT
R.gpio[2].digital=True

R.gpio[1].mode=robot.OUTPUT
R.gpio[1].digital=False
time.sleep(1)
outputstate = True

while True:
    R.gpio[2].digital = outputstate
    R.gpio[1].digital = not outputstate
    time.sleep(1)
    outputstate = not outputstate


#Hello(11)Code for When the Switch is Used to Turn the LED ON or OFF
import robot
import time
R=robot.Robot()
R.gpio[0].mode=robot.INPUT
R.gpio[1].mode=robot.OUTPUT
R.gpio[2].mode=robot.OUTPUT

while True:
    print(R.gpio[0].digital)
    if R.gpio[0].digital == False: #turns led on
        R.gpio[2].digital=True
        R.gpio[1].digital=False
        time.sleep(1)

    if R.gpio[0].digital == True: #turns led off
        R.gpio[2].digital=False
        R.gpio[1].digital=True
        time.sleep(1)

print(“hello”)

