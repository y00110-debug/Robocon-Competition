#Hello(57)Code for Making the Servo Move in the Direction of the AprilTag Sensedimport robot
import time
R=robot.Robot()
R.gpio[0].mode=robot.INPUT
R.gpio[1].mode=robot.OUTPUT
R.gpio[2].mode=robot.OUTPUT

#R = robot.Robot()R.servos[0].mode = robot.PWM_SERVO

while True:
    markers=R.see()
    #print(markers)
    for marker in markers:
        print(marker.bearing.y)
        R.servos[0]=-10*(marker.bearing.y)
        #set servo 1 to the -100%
        time.sleep(1)


