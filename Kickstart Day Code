#Hello(70)Code for Making the Motors Move
import robot
import time
R=robot.Robot()
R.gpio[0].mode=robot.INPUT
R.gpio[1].mode=robot.OUTPUT
R.gpio[2].mode=robot.OUTPUT

#R = robot.Robot()R.servos[0].mode = robot.PWM_SERVO

while True:
#set motor 1 to 60% power
    R.motors[0]=100
    #one of the motors goes the other way but this code makes it go in a straight line
    R.motors[1]=-100
#turn both motors off#
    time.sleep(1)
    R.motors[0]=0
    R.motors[1]=0
