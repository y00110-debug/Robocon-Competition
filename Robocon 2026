      time.sleep(0.2)
      R.motors[0] = 80
      R.motors[1] = -80
      time.sleep(0.2)
      print('Made it to the marker.')      
  if len(markers) == 0:
    print('Lost the marker, trying again.')
    savedMarkers.remove(markertoFollow)
    findCrate(savedMarkers)      
  if grabBox == True: #if we're grabbing a crate
    grabCrate(initial)
  else:
    return 0 

def seekMarker(markertoFollow,lastAngle):
  markers = R.see()
  if len(markers) == 0: #increasing precision when really close to the crate
    print('Lost the marker, going backwards.')
    R.motors[0] = -20
    R.motors[1] = 20
    time.sleep(0.5)
    correcting = (-1)*(lastAngle/3)
    if correcting>0:
      turnRight(correcting)
    else:
      turnLeft(correcting)
  for marker in markers:
    if marker.info.id == markertoFollow:
      angle = int((5)*(marker.bearing.y))
      print('Angle:',angle)
      if -10<=angle<=10:
        print('Facing towards the marker.')
        time.sleep(1)
      elif angle<0:
        print('Tracking to the right.')
        turnRight(angle/4)
      elif angle<0:
        print('Tracking to the left.')
        turnLeft(angle/4)
             
             












             
